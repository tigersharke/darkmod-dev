#!/bin/sh
# FreeBSD port launcher for The Dark Mod engine

DARKMOD_HOME="${HOME}/.darkmod"
DATADIR="%%DATADIR%%"
CFG="${DARKMOD_HOME}/Darkmod.cfg"

mkdir -p "${DARKMOD_HOME}"

first_run=0
win_w=1280
win_h=800

if [ ! -f "${CFG}" ]; then
	first_run=1
	width=
	height=

	# 1) xrandr (X11) — prefer current mode (*)
	if command -v xrandr >/dev/null 2>&1; then
		res=$(xrandr 2>/dev/null | awk '/\*/ { print $1; exit }')
		if [ -z "${res}" ]; then
			res=$(xrandr 2>/dev/null | awk '/ connected/ {
				for (i = 1; i <= NF; i++)
					if ($i ~ /^[0-9]+x[0-9]+/) { print $i; exit }
			}')
		fi
		width=${res%x*}
		height=${res#*x}
	fi

	# 2) xdpyinfo (X11)
	if [ -z "${width}" ] && command -v xdpyinfo >/dev/null 2>&1; then
		res=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ { print $2; exit }')
		width=${res%x*}
		height=${res#*x}
	fi

	# 3) wlr-randr (Wayland)
	if [ -z "${width}" ] && command -v wlr-randr >/dev/null 2>&1; then
		res=$(wlr-randr 2>/dev/null | awk '/^[ \t]*[0-9]+x[0-9]+/ { print $1; exit }')
		width=${res%x*}
		height=${res#*x}
	fi

	case "${width}" in
		''|*[!0-9]*|0) width=1280; height=800 ;;
	esac
	case "${height}" in
		''|*[!0-9]*|0) width=1280; height=800 ;;
	esac

	win_w=$((width * 80 / 100))
	win_h=$((height * 80 / 100))
	[ "${win_w}" -lt 1024 ] && win_w=1024
	[ "${win_h}" -lt 720 ]  && win_h=720
	[ "${win_w}" -gt 1920 ] && win_w=1920
	[ "${win_h}" -gt 1080 ] && win_h=1080

	cat > "${CFG}" << EOF
seta r_fullscreen "0"
seta r_mode "-1"
seta r_customWidth "${win_w}"
seta r_customHeight "${win_h}"
seta in_grabmouse "1"
seta sensitivity "30"
seta sensitivityMenu "1.0"
EOF
fi

for f in DarkmodKeybinds.cfg DarkmodPadbinds.cfg; do
	if [ ! -f "${DARKMOD_HOME}/${f}" ] && [ -f "${DATADIR}/${f}" ]; then
		cp "${DATADIR}/${f}" "${DARKMOD_HOME}/"
	fi
done

cd "${DARKMOD_HOME}" || exit 1

if [ "${first_run}" -eq 1 ]; then
	# First run: wrapper forces windowed defaults (after "$@" so wrapper wins).
	exec "${DATADIR}/thedarkmod" \
		+set fs_basepath "${DATADIR}" \
		+set fs_savepath "${DARKMOD_HOME}" \
		"$@" \
		+set r_fullscreen 0 \
		+set r_mode -1 \
		+set r_customWidth "${win_w}" \
		+set r_customHeight "${win_h}" \
		+set sensitivity 30 \
		+set sensitivityMenu 1.0
else
	exec "${DATADIR}/thedarkmod" \
		+set fs_basepath "${DATADIR}" \
		+set fs_savepath "${DARKMOD_HOME}" \
		+set sensitivity 30 \
		+set sensitivityMenu 1.0 \
		"$@"
fi
